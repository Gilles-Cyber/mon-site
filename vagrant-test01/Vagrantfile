Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_version = "20241002.0.0"

  # Configure the hostname
  config.vm.hostname = "ubuntu-jammy"

  # configuration du provider virtualbox
  config.vm.provider "virtualbox" do |vb|
    vb.name = "ubuntu-jammy"
    vb.memory = "2048"
    vb.cpus = 2
  end

  # IP privée de la VM : l'application est accessible en tapant http://192.168.56.10
  config.vm.network "private_network", ip: "192.168.56.10"

  # Redirections depuis Windows (localhost) : application, Grafana, Prometheus
  config.vm.network "forwarded_port", guest: 80, host: 8080
  config.vm.network "forwarded_port", guest: 3000, host: 3001
  config.vm.network "forwarded_port", guest: 9090, host: 9090

  # Provisioning : installation automatique de Docker dans la VM
  config.vm.provision "docker-install", type: "shell", path: "scripts/install-docker.sh"

  # À chaque "vagrant up" : démarre (ou met à jour) l'application + Prometheus + Grafana + Watchtower
  config.vm.provision "stack", type: "shell", run: "always", inline: <<-SHELL
    docker rm -f site-gilles-parfait 2>/dev/null || true
    docker rm -f site 2>/dev/null || true
    cd /vagrant && docker compose up -d --remove-orphans
  SHELL
end
